proxy_dll/build/
proxy_dll/tools/*.exe
proxy_dll/tools/*.obj

# Vendored third-party dependency (MinHook) - re-fetched by CMake, not project source
proxy_dll/third_party/

# Downloaded third-party tool, not project source (55MB radare2 build)
# (anchored to repo root - proxy_dll/tools/ has its own real source scripts, kept)
/tools/

# Claude Code local session config
.claude/

# Stray empty file from an earlier session, not real content
/nul
