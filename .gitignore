# Python
__pycache__/
*.pyc

# Runtime output, not source. The reader now writes these under
# %LOCALAPPDATA%\MKLegacyKollectionAccess; kept for older checkouts.
ocr_reader/reader_log.txt
ocr_reader/library_misses/
ocr_reader/reader.lock

# Developer-mode (F2) full-screen review images - only the cropped .png is a library file
ocr_reader/known_screens/*.full.png

# Packaging output (packaging/build.py)
/build/
/dist/

# Dev/calibration scratch captures - large, superseded by ocr_reader/known_screens/
# (a handful of these were hand-reviewed and promoted into known_screens/ already)
/ocr_reader/*.png
ocr_reader/sequence/
ocr_reader/sequence_tabbar/

# C++ build output - regenerate with CMake, don't need to ship it
proxy_dll/build/
proxy_dll/tools/*.exe
proxy_dll/tools/*.obj

# Vendored third-party dependency (MinHook) - re-fetched by CMake, not project source
proxy_dll/third_party/

# Downloaded third-party tool, not project source (55MB radare2 build)
# (anchored to repo root - proxy_dll/tools/ has its own real source scripts, kept)
/tools/

# Claude Code local session config
.claude/

# Stray empty file from an earlier session, not real content
/nul
native/legacyhook/out/
